{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?endpoint=$1"
    }
  ],
  "functions": {
    "api/*.py": {
      "includeFiles": "index.html,css/**,js/**,fonts/**,public/**,assets/**,carousel_engine.py"
    }
  }
}
